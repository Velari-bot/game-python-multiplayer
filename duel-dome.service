[Unit]
Description=Duel Dome FastAPI WebSocket Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/duel-dome/server
Environment="PATH=/opt/duel-dome/venv/bin"
ExecStart=/opt/duel-dome/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 3000 --workers 1
Restart=always
RestartSec=10

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/duel-dome

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=duel-dome

[Install]
WantedBy=multi-user.target

